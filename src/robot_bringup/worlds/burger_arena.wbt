#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/TurtleBot3Burger.proto"

WorldInfo {
  info [ "TurtleBot3 Burger arena for ROS 2 hardware-compatible bringup." ]
  title "TurtleBot3 Burger ROS 2"
  basicTimeStep 10
  coordinateSystem "ENU"
  contactProperties [
    ContactProperties {
      material1 "caster"
      material2 "default"
      coulombFriction [ 0 ]
    }
    ContactProperties {
      material1 "wheel"
      material2 "default"
      coulombFriction [ 1 ]
    }
  ]
}
Viewpoint {
  orientation -0.377 0.156 0.913 0.85
  position 5 -6 7
}
Background {
  skyColor [ 0.65 0.76 0.88 ]
}
DirectionalLight {
  direction -0.5 0.3 -1
  intensity 1
  castShadows TRUE
}
Solid {
  translation 0 0 -0.05
  name "floor"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.72 0.72 0.70 roughness 1 metalness 0 }
      geometry DEF FLOOR Box { size 8 8 0.1 }
    }
  ]
  boundingObject USE FLOOR
}
Solid {
  translation 0 4.05 0.3
  name "north wall"
  children [ Shape {
    appearance DEF WALL_APPEARANCE PBRAppearance { baseColor 0.85 0.85 0.9 roughness 1 metalness 0 }
    geometry DEF LONG_WALL Box { size 8.2 0.1 0.6 }
  } ]
  boundingObject USE LONG_WALL
}
Solid {
  translation 0 -4.05 0.3
  name "south wall"
  children [ Shape { appearance USE WALL_APPEARANCE geometry USE LONG_WALL } ]
  boundingObject USE LONG_WALL
}
Solid {
  translation 4.05 0 0.3
  rotation 0 0 1 1.57079632679
  name "east wall"
  children [ Shape { appearance USE WALL_APPEARANCE geometry USE LONG_WALL } ]
  boundingObject USE LONG_WALL
}
Solid {
  translation -4.05 0 0.3
  rotation 0 0 1 1.57079632679
  name "west wall"
  children [ Shape { appearance USE WALL_APPEARANCE geometry USE LONG_WALL } ]
  boundingObject USE LONG_WALL
}
Solid {
  translation 1.5 0.8 0.25
  name "box obstacle"
  children [ Shape {
    appearance PBRAppearance { baseColor 0.65 0.32 0.14 roughness 1 metalness 0 }
    geometry DEF OBSTACLE Box { size 0.5 0.6 0.5 }
  } ]
  boundingObject USE OBSTACLE
}
Solid {
  translation -1.2 -1.2 0.3
  name "cylinder obstacle"
  children [ Shape {
    appearance PBRAppearance { baseColor 0.25 0.4 0.7 roughness 1 metalness 0 }
    geometry DEF CYLINDER Cylinder { radius 0.3 height 0.6 }
  } ]
  boundingObject USE CYLINDER
}
TurtleBot3Burger {
  translation 0 0 0
  name "TurtleBot3Burger"
  controller "<extern>"
}
